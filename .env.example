# ---- Supabase ----
# Project: "Social media Project"  (ref: cqlspabncujagkdvzuyt)
# Dashboard > Settings > API
SUPABASE_URL=https://cqlspabncujagkdvzuyt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cron auth ----
# Generate with:  openssl rand -hex 32
# Vercel Cron sends this automatically as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---- Pipeline testing ----
# true  = every platform resolves to the mock adapter (no real credentials, no
#         real posts). Use this to verify the scheduler end to end.
# unset = real adapters. Never set this in production.
MOCK_PUBLISH=

# ---- YouTube (Phase 3) ----
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (type: Desktop app or Web app). Enable "YouTube Data API v3" on the project.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Per-account refresh tokens belong in Supabase Vault, pointed at by
# accounts.token_secret_name — see supabase/migrations/002_vault_secret_access.sql.
# This env fallback is only for a single-channel setup with no Vault secret.
YOUTUBE_REFRESH_TOKEN=

# Optional YouTube upload settings (defaults shown as comments)
# public | unlisted | private                            (default: public)
YOUTUBE_PRIVACY_STATUS=
# Numeric Data API category id; 22 = People & Blogs      (default: 22)
YOUTUBE_CATEGORY_ID=
# COPPA self-declaration; "true" marks uploads made-for-kids (default: false)
YOUTUBE_MADE_FOR_KIDS=
# Refuse media larger than this many bytes         (default: 268435456 = 256 MiB)
# Only raise this alongside maxDuration on Vercel Pro.
YOUTUBE_MAX_MEDIA_BYTES=

# ---- Meta: Instagram + Facebook (Phase 4, keep blank for now) ----
META_APP_ID=
META_APP_SECRET=
